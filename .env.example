# Copy to .env and adjust. Never commit the real .env.

# PostgreSQL connection string
DATABASE_URL=postgres://stocksense:stocksense@127.0.0.1:5432/stocksense

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# API port
PORT=4000

# development | production | test
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API (only needed when
# the SPA is served from a different origin than the API).
CORS_ORIGINS=http://localhost:5173

# SMTP for OTP password-reset emails. When SMTP_HOST is empty the OTP is written to
# the server log instead (fine for local development, not for production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StockSense <no-reply@stocksense.local>"

# Development only: return the OTP in the API response so the reset flow can be
# demoed without an inbox. Ignored when NODE_ENV=production.
OTP_DEV_ECHO=true
