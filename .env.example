# Copy to .env and adjust. Never commit the real .env.

# PostgreSQL connection string
DATABASE_URL=postgres://stocksense:stocksense@127.0.0.1:5432/stocksense

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# API port
PORT=4000

# development | production | test
NODE_ENV=development

# Comma-separated list of browser origins allowed to call the API (only needed when
# the SPA is served from a different origin than the API).
CORS_ORIGINS=http://localhost:5173

# Public address of the app, used for links in emails (verification, reset, invites).
APP_URL=http://localhost:5173

# Email. Set ONE provider; the first one found wins. Without any, codes and links are
# written to the server log (fine locally, not for production).
MAIL_FROM="StockSense <no-reply@example.com>"
# HTTPS APIs (work where SMTP ports are blocked, e.g. Render's free tier)
RESEND_API_KEY=
BREVO_API_KEY=
# Or plain SMTP, e.g. Hostinger: smtp.hostinger.com, port 465, the full mailbox address as user
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Development only: return codes and links in API responses so the flows can be
# demoed without an inbox. Ignored when NODE_ENV=production.
OTP_DEV_ECHO=true
